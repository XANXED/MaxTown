# Скопируйте в .env и заполните. .env в git не попадает.

# Бот MaxTown в MAX. Токен — в настройках бота на платформе MAX для партнёров
# (https://business.max.ru). API проверяет им подпись initData мини-аппа и
# вызывает MAX API. Локально без настоящего токена `npm run local` подставит
# свой: вход по ссылкам работает, а Домовые чаты MAX — нет.
BOT_TOKEN=

# Публичное имя бота MaxTown без @. Нужен кнопкам запуска мини-приложения.
MAX_BOT_USERNAME=t25_hakaton_max_bot

# Сколько секунд после запуска мини-аппы принимается подписанный initData MAX.
MAX_INIT_DATA_TTL_SECONDS=900

# Случайная строка из латинских букв, цифр, дефиса или подчёркивания (5–256 символов).
# MAX присылает её в заголовке каждого события webhook.
MAX_WEBHOOK_SECRET=

# Секрет служебного POST /api/max/register (подписка webhook): заголовок
# x-maxtown-internal-secret. Вызвать один раз после деплоя.
MAXTOWN_INTERNAL_SECRET=
# Публичный адрес, который знает MAX: на него регистрируется webhook.
# В продакшне его задаёт compose.prod.yml из DOMAIN (.env.production.example).
# MAXTOWN_PUBLIC_URL=https://maxtown.ru

# От каких адресов API доверяет X-Forwarded-For: список адресов или подсетей
# через запятую, «uniquelocal» — частные сети (так в compose.prod.yml за Caddy).
# Пусто — не доверяем. Локально не нужно.
# TRUST_PROXY=uniquelocal

# off — не объявлять новые Опросы в Домовых чатах (по умолчанию объявляем).
# MAX_CHAT_NOTIFICATIONS=off

# Серверный API-ключ DaData: точный адрес Дома по названию Домового чата.
# Не добавляйте его в VITE_*: ключ не должен попадать в браузерную сборку.
DADATA_API_KEY=

# Сгенерируйте отдельный постоянный секрет: openssl rand -hex 32. Не меняйте при каждом запуске.
POLL_VOTER_NULLIFIER_SECRET=

# Обязательные учётные данные панели Модератора для production/Compose.
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD_HASH=

# PostgreSQL для API (локальная база должна быть запущена отдельно).
DATABASE_URL=postgres://maxtown:change-me@localhost:5432/maxtown

# Переменные локального Docker Compose. Перед запуском задайте собственный пароль.
POSTGRES_DB=maxtown
POSTGRES_USER=maxtown
POSTGRES_PASSWORD=change-me
COMPOSE_DATABASE_URL=postgres://maxtown:change-me@postgres:5432/maxtown
WEB_IMAGE=maxtown-api:local

# Куда Cloudflare Worker (npm run dev:bot) пересылает /api/*. В Cloudflare
# задаётся переменной Worker'а.
# API_ORIGIN=http://localhost:3000

# Порт локального API; в Render задаётся PORT автоматически.
API_PORT=3000
# Серверный ключ API data.mos.ru для импорта телефона управляющей организации.
DATA_MOS_API_KEY=
# Ключ 2ГИС (Places API) для Ближайших мест: только сервер, в клиент не попадает.
# Демо-ключ — 30 дней и не больше 10 результатов на запрос; ответы 2ГИС хранить
# нельзя (docs/adr/0008). Без ключа Ближайшие места выключены, Закреплённые работают.
DGIS_API_KEY=
# Ключ карты 2ГИС (MapGL) для мини-аппа. Попадает в код страницы — в кабинете
# 2ГИС ограничьте его по домену мини-аппа. Пока берём тот же ключ, что у API.
VITE_DGIS_API_KEY=$DGIS_API_KEY
