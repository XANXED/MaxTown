# Скопируйте в .env и заполните. .env в git не попадает.

# Создайте VK Mini App и укажите ID и защищённый ключ приложения.
# Обязательны для production API, сервер проверяет подписанные launch-параметры VK.
VK_APP_ID=
VK_APP_SECRET=
VK_GROUP_ID=
VK_GROUP_TOKEN=
# Render генерирует эти значения; в VK Callback API их нужно скопировать из Render.
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

# Для локальной работы задайте постоянный секрет: openssl rand -hex 32. Render генерирует его сам.
POLL_VOTER_NULLIFIER_SECRET=

# Локально оставьте все три поля пустыми или задайте имя и пароль длиной от 32 ASCII-символов.
# Render генерирует MODERATOR_PASSWORD автоматически. MODERATOR_PASSWORD_HASH оставлен
# для ручного выбора пароля и совместимости с уже настроенными окружениями.
MODERATOR_USERNAME=
MODERATOR_PASSWORD=
# MODERATOR_PASSWORD_HASH=

# PostgreSQL для API (локальная база должна быть запущена отдельно).
DATABASE_URL=postgres://maxtown:change-me@localhost:5432/maxtown

# Переменные локального Docker Compose. Перед запуском задайте собственный пароль.
POSTGRES_DB=maxtown
POSTGRES_USER=maxtown
POSTGRES_PASSWORD=change-me
COMPOSE_DATABASE_URL=postgres://maxtown:change-me@postgres:5432/maxtown
WEB_IMAGE=maxtown-api:local

# Порт локального API; в Render задаётся PORT автоматически.
API_PORT=3000
