# Скопируйте в .env и заполните. .env в git не попадает.

# Токен из настроек бота на платформе MAX для партнёров (https://business.max.ru)
BOT_TOKEN=

# Публичное имя бота MaxTown без @. Нужен кнопкам запуска мини-приложения.
MAX_BOT_USERNAME=t25_hakaton_max_bot

# Необязательные Домовые чаты для начального заполнения реестра.
# Обычно чат регистрирует сам бот после получения прав администратора.
MAX_HOUSE_CHATS=[]

# Куда API сохраняет локальный реестр чатов. По умолчанию: .data/house-chats.json.
# MAX_CHAT_REGISTRY_PATH=

# Секрет ручного служебного endpoint локального API.
MAXTOWN_INTERNAL_SECRET=

# Сколько секунд после запуска мини-аппы принимается подписанный initData MAX.
MAX_INIT_DATA_TTL_SECONDS=900

# Случайная строка из латинских букв, цифр, дефиса или подчёркивания (5–256 символов).
# Один и тот же секрет задаётся в Cloudflare и передаётся MAX при регистрации webhook.
MAX_WEBHOOK_SECRET=

# Серверный API-ключ DaData для определения адреса по названию чата.
# Не добавляйте его в VITE_*: ключ не должен попадать в браузерную сборку.
DADATA_API_KEY=

# Порт API
API_PORT=3000
