{
  "name": "maxtown",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "local": "node scripts/dev-local.ts",
    "dev:miniapp": "npm run dev -w @maxtown/miniapp",
    "dev:admin": "npm run dev -w @maxtown/admin",
    "dev:api": "npm run dev -w @maxtown/api",
    "dev:edge": "npm run dev -w @maxtown/edge",
    "dev:link": "npm run dev:link -w @maxtown/api --silent --",
    "moderator:hash": "npm run moderator:hash -w @maxtown/api --silent --",
    "mcp:project": "npm run start -w @maxtown/project-mcp",
    "smoke:mcp": "vitest run packages/project-mcp/src/stdio-smoke.test.ts",
    "build": "npm run build --workspaces --if-present",
    "build:cloudflare": "npm run build -w @maxtown/miniapp && npm run deploy:dry -w @maxtown/edge",
    "deploy:cloudflare": "npm run build -w @maxtown/miniapp && npm run deploy -w @maxtown/edge",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
