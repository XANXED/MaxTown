# Copy to /opt/maxtown/.env on the VPS; chmod 600. Never commit the filled file.
DOMAIN=maxtown.example.com

POSTGRES_DB=maxtown
POSTGRES_USER=maxtown
POSTGRES_PASSWORD=replace_with_url_safe_random_secret
DATABASE_URL=postgres://maxtown:replace_with_url_safe_random_secret@postgres:5432/maxtown

# MAX bot token is used by the API to validate WebApp initData. Obtain from Master Bot.
BOT_TOKEN=replace_with_max_bot_token

# Caddy Basic Auth username and hash. Generate the hash with: caddy hash-password
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD_HASH='$2a$14$replace_with_the_complete_caddy_hash'
