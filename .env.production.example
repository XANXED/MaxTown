# Продакшн на сервере Timeweb Cloud (docs/deployment.md). На сервере скопируйте
# в .env рядом с compose.yml и заполните; ./deploy/deploy.sh сам поставит chmod 600.
# Заполненный файл в git не попадает.

# Домен без схемы: на нём Caddy получает HTTPS-сертификат, на него же MAX
# шлёт события бота. A-записи домена и www — на IP сервера.
DOMAIN=maxtown.ru

# Рекомендуемый путь: ./deploy/prepare-env.sh спросит только внешние ключи и
# пароль Модератора, а эти внутренние секреты заполнит автоматически.
# PostgreSQL в контейнере на этом же сервере. Пароль — только латиница и
# цифры, минимум 32 символа (он же входит в COMPOSE_DATABASE_URL).
POSTGRES_DB=maxtown
POSTGRES_USER=maxtown
POSTGRES_PASSWORD=
COMPOSE_DATABASE_URL=postgres://maxtown:ПАРОЛЬ@postgres:5432/maxtown

# Бот MAX: токен — в настройках бота на https://business.max.ru.
BOT_TOKEN=
MAX_BOT_USERNAME=t25_hakaton_max_bot
# 5–256 латинских букв, цифр или «-»: openssl rand -hex 32
MAX_WEBHOOK_SECRET=
# Секрет для POST /api/max/register (подписка бота на события): openssl rand -hex 32
MAXTOWN_INTERNAL_SECRET=

# Адрес Дома по названию Домового чата (ГАР): https://dadata.ru/profile/#info
DADATA_API_KEY=

# 2ГИС: Ближайшие места и карта. Ключ виден в коде страницы — в кабинете 2ГИС
# ограничьте его доменом maxtown.ru. Без ключа Ближайшие места выключены.
DGIS_API_KEY=

# Панель Модератора: https://maxtown.ru/admin/. Хеш пароля — npm run moderator:hash -- <пароль>
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD_HASH=''

# Постоянный секрет анонимных Опросов, не меньше 32 байт: openssl rand -hex 32.
# Не меняйте после запуска — иначе Жильцы смогут проголосовать повторно.
POLL_VOTER_NULLIFIER_SECRET=
